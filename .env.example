NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_a11y_qa?schema=public
POSTGRES_DB=email_a11y_qa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=auth-template-api
JWT_AUDIENCE=auth-template-web
JWT_TTL_SECONDS=900

REMEMBER_TTL_SECONDS=2592000
MAX_REMEMBERED_SESSIONS=5
BCRYPT_ROUNDS=12
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_RESET_TTL_SECONDS=1800
# También controla cuánto dura el enlace de invitación inicial (86400 = 24 horas).
EMAIL_VERIFICATION_TTL_SECONDS=86400

APP_NAME=Auth Template
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-your-smtp-password-or-app-password
MAIL_FROM=Auth Template <no-reply@example.com>

# En development puedes activar las cuentas demo. En production debes sustituir sus credenciales.
SEED_USERS_ENABLED=false

SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=Replace-superadmin-password-1!
SEED_SUPERADMIN_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Replace-admin-password-1!
SEED_ADMIN_NAME=Example
SEED_ADMIN_LAST_NAME=Admin

SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=Replace-user-password-1!
SEED_USER_NAME=Example
SEED_USER_LAST_NAME=User
